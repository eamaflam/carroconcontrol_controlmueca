</block></statement><next><block type=\"device_pause\"><value name=\"pause\"><shadow type=\"timePicker\"><field name=\"ms\">100</field></shadow></value></block></next></block></next></block></next></block></next></block></statement></block></xml>","main.ts":"// ============================================================\n// CONTROL  -  micro:bit en tu mano\n//   Inclinar hacia el frente  -> avanzar\n//   Inclinar hacia atrás      -> reversa\n//   Botón A                   -> izquierda\n//   Botón B                   -> derecha\n//   A + B juntos o soltar todo -> alto\n// ============================================================\nconst GRUPO = 60     // debe ser el mismo número en el carro\nconst UMBRAL = 500   // sensibilidad de la inclinación (más bajo = más sensible; 1024 = 90°)\n\nlet ordenActual = \"\"\n\nradio.setGroup(GRUPO)\nbasic.showIcon(IconNames.SmallHeart)\n\nbasic.forever(function () {\n    let orden = \"alto\"\n    let y = input.acceleration(Dimension.Y)\n\n    if (input.buttonIsPressed(Button.A) && input.buttonIsPressed(Button.B)) {\n        orden = \"alto\"\n    } else if (input.buttonIsPressed(Button.A)) {\n        orden = \"izquierda\"\n    } else if (input.buttonIsPressed(Button.B)) {\n        orden = \"derecha\"\n    } else if (y < -UMBRAL) {\n        orden = \"avanzar\"\n    } else if (y > UMBRAL) {\n        orden = \"reversa\"\n    }\n\n    // Se envía cada 100 ms; el carro se detiene si deja de recibir.\n    radio.sendString(orden)\n\n    if (orden != ordenActual) {\n        ordenActual = orden\n        if (orden == \"avanzar\") {\n            basic.showArrow(ArrowNames.North)\n        } else if (orden == \"reversa\") {\n            basic.showArrow(ArrowNames.South)\n        } else if (orden == \"izquierda\") {\n            basic.showArrow(ArrowNames.West)\n        } else if (orden == \"derecha\") {\n            basic.showArrow(ArrowNames.East)\n        } else {\n            basic.showIcon(IconNames.No)\n        }\n    }\n    basic.pause(100)\n})","README.md":"","main.py":"basic.show_icon(IconNames.HEART)\nradio.set_group(1)\nradio.send_number(7)\npins.set_pull(DigitalPin.P1, PinPullMode.PULL_DOWN)\npins.set_pull(DigitalPin.P2, PinPullMode.PULL_DOWN)\n\ndef on_forever():\n    if GHBit.button(GHBit.enButton.B3, GHBit.enButtonState.PRESS):\n        radio.send_string(\"G\")\nbasic.forever(on_forever)\n\ndef on_forever2():\n    if GHBit.button(GHBit.enButton.B4, GHBit.enButtonState.PRESS):\n        radio.send_string(\"H\")\nbasic.forever(on_forever2)\n\ndef on_forever3():\n    if GHBit.rocker(GHBit.enRocker.UP):\n        radio.send_string(\"A\")\n        basic.show_arrow(ArrowNames.NORTH)\n    elif GHBit.rocker(GHBit.enRocker.RIGHT):\n        radio.send_string(\"D\")\n        basic.show_arrow(ArrowNames.EAST)\n    elif GHBit.rocker(GHBit.enRocker.PRESS):\n        radio.send_string(\"I\")\n        basic.show_icon(IconNames.NO)\n    elif GHBit.rocker(GHBit.enRocker.NOSTATE):\n        radio.send_string(\"0\")\n        basic.show_icon(IconNames.NO)\n    elif GHBit.rocker(GHBit.enRocker.DOWN):\n        radio.send_string(\"B\")\n        basic.show_arrow(ArrowNames.SOUTH)\n    elif GHBit.rocker(GHBit.enRocker.LEFT):\n        radio.send_string(\"C\")\n        basic.show_arrow(ArrowNames.WEST)\nbasic.forever(on_forever3)\n\ndef on_forever4():\n    if GHBit.button(GHBit.enButton.B1, GHBit.enButtonState.PRESS):\n        radio.send_string(\"E\")\nbasic.forever(on_forever4)\n\ndef on_forever5():\n    if GHBit.button(GHBit.enButton.B2, GHBit.enButtonState.PRESS):\n        radio.send_string(\"F\")\nbasic.forever(on_forever5)\n","pxt.json":"{\n    \"name\": \"carroconcontrol_controlmuñeca\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"GHBit\": \"github:yahboomtechnology/ghbitlib#888de80746a09e25150e25e63b6209f49c069ffd\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",